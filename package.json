{
  "name": "loom-and-layer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Loom & Layer — premium curtains & window styling website template",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend && node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('frontend/dist','dist',{recursive:true})\"",
    "preview": "npm run preview --workspace frontend",
    "test": "npm run test --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "images": "npm run images --workspace frontend"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
