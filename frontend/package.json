{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/bin.mjs vite",
    "build": "node scripts/bin.mjs tsc --noEmit && node scripts/bin.mjs vite build",
    "preview": "node scripts/bin.mjs vite preview",
    "typecheck": "node scripts/bin.mjs tsc --noEmit",
    "test": "node scripts/bin.mjs vitest run",
    "test:watch": "node scripts/bin.mjs vitest",
    "images": "node scripts/bin.mjs tsx scripts/generate-images.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
